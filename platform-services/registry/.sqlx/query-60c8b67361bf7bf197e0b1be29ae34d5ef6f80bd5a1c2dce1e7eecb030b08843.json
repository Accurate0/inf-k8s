  "query": "UPDATE cli_packages SET\n            description = COALESCE($2, description),\n            binary_name = COALESCE($3, binary_name),\n            aliases = COALESCE($4, aliases),\n            updated_at = now()\n         WHERE name = $1\n         RETURNING id, name, description, binary_name, aliases, created_at",
