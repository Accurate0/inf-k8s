{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkflowDef",
  "type": "object",
  "properties": {
    "candidates": {
      "description": "Replaces the built-in candidate query. Must return series carrying a\n`client_ip` label; the value becomes `detections`.",
      "anyOf": [
        {
          "$ref": "#/$defs/Template"
        },
        {
          "type": "null"
        }
      ]
    },
    "duration": {
      "$ref": "#/$defs/BlockDuration"
    },
    "enabled": {
      "$ref": "#/$defs/Enabled"
    },
    "gateway": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "name": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "signals": {
      "description": "LogQL instant queries evaluated per candidate IP, compared by the\n`signal` matcher.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Template"
      }
    },
    "when": {
      "$ref": "#/$defs/Matcher"
    },
    "window": {
      "anyOf": [
        {
          "$ref": "#/$defs/Span"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "duration",
    "reason",
    "when"
  ],
  "$defs": {
    "BlockDuration": {
      "description": "How long a block lasts: a duration such as `24h`, or `forever`.",
      "type": "string",
      "pattern": "^(forever|\\d+[smhd])$"
    },
    "Combinator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Matcher"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Matcher"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Matcher"
            }
          },
          "additionalProperties": false,
          "required": [
            "not"
          ]
        }
      ]
    },
    "Enabled": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "active",
            "disabled"
          ]
        },
        {
          "description": "Logs what it would block and records a metric, but creates nothing.",
          "type": "string",
          "const": "dry-run"
        }
      ]
    },
    "LeafMatcher": {
      "description": "Every leaf reads one of the fact sources gathered per candidate IP: the\ndetection total, the per-rule breakdown, the requested URIs, or a signal.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "default": null,
              "minimum": 0
            },
            "min": {
              "type": "integer",
              "format": "uint64",
              "default": 0,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "detections"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "distinct_rules"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "min"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "rule_id"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "mode": {
              "$ref": "#/$defs/StringMatchMode"
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "rule_msg_matches"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "patterns"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "severity"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "mode": {
              "$ref": "#/$defs/StringMatchMode"
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "uri_matches"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "patterns"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "default": null,
              "minimum": 0
            },
            "min": {
              "type": "integer",
              "format": "uint64",
              "default": 0,
              "minimum": 0
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "signal"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ]
        }
      ]
    },
    "Matcher": {
      "anyOf": [
        {
          "$ref": "#/$defs/Combinator"
        },
        {
          "$ref": "#/$defs/LeafMatcher"
        }
      ]
    },
    "Span": {
      "description": "A duration such as `30m`, `12h` or `7d`.",
      "type": "string",
      "pattern": "^\\d+[smhd]$"
    },
    "StringMatchMode": {
      "type": "string",
      "enum": [
        "contains",
        "prefix",
        "exact"
      ]
    },
    "Template": {
      "description": "A LogQL query with `{{name}}` placeholders. `{{window}}`, `{{limit}}` and the\nfragments from [`crate::loki::Loki::fragments`] are always available;\n`{{client_ip}}`, `{{prefilter}}` and `{{exact_client}}` only in a signal, which\nis evaluated against one address.",
      "type": "string"
    }
  }
}
