{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "allowlist_refresh": {
      "$ref": "#/$defs/Span"
    },
    "allowlist_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AllowlistSource"
      }
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "ignored_rule_ids": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "manual_unblock_cooldown": {
      "$ref": "#/$defs/Span"
    },
    "never_block": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkflowDef"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "$defs": {
    "AllowlistSource": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "format": {
          "$ref": "#/$defs/SourceFormat"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "format"
      ]
    },
    "BlockDuration": {
      "description": "How long a block lasts: a duration such as `24h`, or `forever`.",
      "type": "string",
      "pattern": "^(forever|\\d+[smhd])$"
    },
    "Combinator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Matcher"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Matcher"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Matcher"
            }
          },
          "additionalProperties": false,
          "required": [
            "not"
          ]
        }
      ]
    },
    "Defaults": {
      "type": "object",
      "properties": {
        "candidate_limit": {
          "type": "integer",
          "format": "uint",
          "default": 50,
          "minimum": 0
        },
        "escalation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          }
        },
        "escalation_decay": {
          "$ref": "#/$defs/Span"
        },
        "fast_candidate_limit": {
          "type": "integer",
          "format": "uint",
          "default": 10,
          "minimum": 0
        },
        "gateway": {
          "type": "string",
          "default": "public-gateway"
        },
        "max_block_duration": {
          "$ref": "#/$defs/Span"
        },
        "max_blocklist_cidrs": {
          "type": "integer",
          "format": "uint",
          "default": 20000,
          "minimum": 0
        },
        "window": {
          "$ref": "#/$defs/Span"
        }
      },
      "additionalProperties": false
    },
    "Enabled": {
      "type": "string",
      "enum": [
        "active",
        "dry-run",
        "disabled"
      ]
    },
    "LeafMatcher": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "default": null,
              "minimum": 0
            },
            "min": {
              "type": "integer",
              "format": "uint64",
              "default": 0,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "detections"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "distinct_rules"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "min"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "rule_id"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "mode": {
              "$ref": "#/$defs/StringMatchMode"
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "rule_msg_matches"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "patterns"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "severity"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "mode": {
              "$ref": "#/$defs/StringMatchMode"
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "uri_matches"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "patterns"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "default": null,
              "minimum": 0
            },
            "min": {
              "type": "integer",
              "format": "uint64",
              "default": 0,
              "minimum": 0
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "signal"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ]
        }
      ]
    },
    "Matcher": {
      "anyOf": [
        {
          "$ref": "#/$defs/Combinator"
        },
        {
          "$ref": "#/$defs/LeafMatcher"
        }
      ]
    },
    "SourceFormat": {
      "type": "string",
      "enum": [
        "github_meta",
        "cloudflare_ips"
      ]
    },
    "Span": {
      "description": "A duration such as `30m`, `12h` or `7d`.",
      "type": "string",
      "pattern": "^\\d+[smhd]$"
    },
    "StringMatchMode": {
      "type": "string",
      "enum": [
        "contains",
        "prefix",
        "exact"
      ]
    },
    "Tier": {
      "type": "string",
      "enum": [
        "fast",
        "standard"
      ]
    },
    "WorkflowDef": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": [
            "string",
            "null"
          ]
        },
        "duration": {
          "$ref": "#/$defs/BlockDuration"
        },
        "enabled": {
          "$ref": "#/$defs/Enabled"
        },
        "gateway": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "signals": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        },
        "when": {
          "$ref": "#/$defs/Matcher"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "duration",
        "reason",
        "when"
      ]
    }
  }
}
