{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "allowlist_refresh": {
      "$ref": "#/$defs/Span"
    },
    "allowlist_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AllowlistSource"
      }
    },
    "defaults": {
      "$ref": "#/$defs/Defaults"
    },
    "ignored_rule_ids": {
      "description": "Noise rather than findings; ignored by the ranking and `distinct_rules`.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "manual_unblock_cooldown": {
      "$ref": "#/$defs/Span"
    },
    "never_block": {
      "description": "Merged with the `WAF_MANAGER_ALLOWLIST` secret and the feeds below.",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "workflows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkflowDef"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "$defs": {
    "AllowlistSource": {
      "type": "object",
      "properties": {
        "fields": {
          "description": "`github_meta` only: which of the response's CIDR arrays to take.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "format": {
          "$ref": "#/$defs/SourceFormat"
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "format"
      ]
    },
    "BlockDuration": {
      "description": "How long a block lasts: a duration such as `24h`, or `forever`.",
      "type": "string",
      "pattern": "^(forever|\\d+[smhd])$"
    },
    "Combinator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Matcher"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Matcher"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Matcher"
            }
          },
          "additionalProperties": false,
          "required": [
            "not"
          ]
        }
      ]
    },
    "Defaults": {
      "type": "object",
      "properties": {
        "candidate_limit": {
          "type": "integer",
          "format": "uint",
          "default": 50,
          "minimum": 0
        },
        "gateway": {
          "type": "string",
          "default": "public-gateway"
        },
        "window": {
          "$ref": "#/$defs/Span"
        }
      },
      "additionalProperties": false
    },
    "Enabled": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "active",
            "disabled"
          ]
        },
        {
          "description": "Logs what it would block and records a metric, but creates nothing.",
          "type": "string",
          "const": "dry-run"
        }
      ]
    },
    "LeafMatcher": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "default": null,
              "minimum": 0
            },
            "min": {
              "type": "integer",
              "format": "uint64",
              "default": 0,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "detections"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "format": "uint",
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "distinct_rules"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "min"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "rule_id"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "mode": {
              "$ref": "#/$defs/StringMatchMode"
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "rule_msg_matches"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "patterns"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "severity"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "min_count": {
              "type": "integer",
              "format": "uint64",
              "default": 1,
              "minimum": 0
            },
            "mode": {
              "$ref": "#/$defs/StringMatchMode"
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "const": "uri_matches"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "patterns"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "default": null,
              "minimum": 0
            },
            "min": {
              "type": "integer",
              "format": "uint64",
              "default": 0,
              "minimum": 0
            },
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "signal"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name"
          ]
        }
      ]
    },
    "Matcher": {
      "anyOf": [
        {
          "$ref": "#/$defs/Combinator"
        },
        {
          "$ref": "#/$defs/LeafMatcher"
        }
      ]
    },
    "SourceFormat": {
      "oneOf": [
        {
          "description": "`https://api.github.com/meta` - a flat object of named CIDR arrays.",
          "type": "string",
          "const": "github_meta"
        },
        {
          "description": "`https://api.cloudflare.com/client/v4/ips` - `result.ipv4_cidrs` and\n`result.ipv6_cidrs`.",
          "type": "string",
          "const": "cloudflare_ips"
        }
      ]
    },
    "Span": {
      "description": "A duration such as `30m`, `12h` or `7d`.",
      "type": "string",
      "pattern": "^\\d+[smhd]$"
    },
    "StringMatchMode": {
      "type": "string",
      "enum": [
        "contains",
        "prefix",
        "exact"
      ]
    },
    "Template": {
      "description": "A LogQL query with `{{name}}` placeholders: `{{window}}`, `{{limit}}` and the\n[`crate::loki::Loki::fragments`] everywhere, plus `{{client_ip}}`,\n`{{prefilter}}` and `{{exact_client}}` in a signal.",
      "type": "string"
    },
    "WorkflowDef": {
      "type": "object",
      "properties": {
        "candidates": {
          "description": "Replaces the built-in candidate query. Must return series carrying a\n`client_ip` label; the value becomes `detections`.",
          "anyOf": [
            {
              "$ref": "#/$defs/Template"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "$ref": "#/$defs/BlockDuration"
        },
        "enabled": {
          "$ref": "#/$defs/Enabled"
        },
        "gateway": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "name": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "signals": {
          "description": "LogQL instant queries evaluated per candidate IP, compared by the\n`signal` matcher.",
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Template"
          }
        },
        "when": {
          "$ref": "#/$defs/Matcher"
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "duration",
        "reason",
        "when"
      ]
    }
  }
}
