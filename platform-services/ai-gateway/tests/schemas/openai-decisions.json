{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenAI Decisions response",
  "type": "object",
  "required": ["answers"],
  "properties": {
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": { "enum": ["predicate", "choice", "score", "refusal"] },
          "name": { "type": "string" },
          "probability": { "type": "number" },
          "choice": { "type": "string" },
          "score": { "type": "number" },
          "confidence": { "type": "number" },
          "probabilities": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["value", "probability"],
              "properties": {
                "probability": { "type": "number" }
              }
            }
          }
        }
      }
    }
  }
}
