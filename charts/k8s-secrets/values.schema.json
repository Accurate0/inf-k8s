{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "k8s-secrets values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "description": "Applied to every entry in secrets that does not override the field.",
      "properties": {
        "provider": { "$ref": "#/definitions/provider" },
        "namespace": { "$ref": "#/definitions/namespace" },
        "resyncInterval": { "$ref": "#/definitions/resyncInterval" },
        "openbaoServer": {
          "type": "string",
          "description": "OpenBao API URL. Defaults to the in-cluster active service."
        },
        "azureStore": {
          "type": "string",
          "description": "ClusterSecretStore used by the azurekv provider. Defaults to k8s-shared-vault."
        },
        "labels": { "$ref": "#/definitions/labels" },
        "annotations": { "$ref": "#/definitions/annotations" }
      }
    },
    "generated": {
      "type": "array",
      "description": "Secrets whose values are generated once, pushed to OpenBao at kv/<namespace>/generated/<name> and synced back.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "secretName",
          "keys"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Names the OpenBao path kv/<namespace>/generated/<name>."
          },
          "namespace": {
            "$ref": "#/definitions/namespace"
          },
          "secretName": {
            "type": "string",
            "description": "Name of the ExternalSecret and of the secret it creates."
          },
          "type": {
            "type": "string",
            "description": "Type of the created secret. Defaults to Opaque."
          },
          "template": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "type": "object",
                "description": "Keys of the created secret, mapped to go templates over the generated keys.",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "length",
                "symbols"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Key in the created secret and property in OpenBao."
                },
                "length": {
                  "type": "integer",
                  "minimum": 1
                },
                "digits": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Defaults to a quarter of the length."
                },
                "symbols": {
                  "type": "integer",
                  "minimum": 0
                },
                "encoding": {
                  "enum": [
                    "raw",
                    "base64",
                    "base64url",
                    "base32",
                    "hex"
                  ],
                  "description": "Defaults to raw."
                }
              }
            }
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "description": "Secrets rendered from configmap templates, filled with keys of other secrets in the namespace.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secretName",
          "configMap",
          "files",
          "values"
        ],
        "properties": {
          "secretName": {
            "type": "string",
            "description": "Name of the ExternalSecret and of the secret it creates."
          },
          "namespace": {
            "$ref": "#/definitions/namespace"
          },
          "configMap": {
            "type": "string",
            "description": "ConfigMap holding the templates."
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "description": "Template files; each becomes a key named after its basename.",
            "items": {
              "type": "string"
            }
          },
          "values": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "secret",
                "key"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Template variable, read as {{ .NAME }}."
                },
                "secret": {
                  "type": "string",
                  "description": "Secret in the namespace to read."
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "description": "One SecretStore per entry, plus one ExternalSecret per managed secret.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "managedSecrets"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Names the SecretStore, which is created as <provider>-<name>. For openbao the remote key defaults to <namespace> when name equals the namespace, otherwise <namespace>/<name>; for azurekv it defaults to <name>."
          },
          "provider": { "$ref": "#/definitions/provider" },
          "key": {
            "type": "string",
            "description": "Remote key to extract for the openbao and azurekv providers, overriding the default derived from name."
          },
          "managedSecrets": {
            "type": "array",
            "description": "Kubernetes secrets to create from this store.",
            "minItems": 1,
            "items": { "$ref": "#/definitions/managedSecret" }
          },
          "namespace": { "$ref": "#/definitions/namespace" },
          "resyncInterval": { "$ref": "#/definitions/resyncInterval" },
          "labels": { "$ref": "#/definitions/labels" },
          "annotations": { "$ref": "#/definitions/annotations" }
        }
      }
    }
  },
  "definitions": {
    "provider": {
      "type": "string",
      "enum": ["openbao", "azurekv"],
      "description": "Secret backend. openbao reads kv/<key> via kubernetes auth; azurekv extracts a JSON-object secret from the Azure ClusterSecretStore. Defaults to openbao."
    },
    "namespace": {
      "type": "string",
      "description": "Namespace the SecretStore and ExternalSecrets are created in."
    },
    "resyncInterval": {
      "type": "integer",
      "minimum": 0,
      "description": "Refresh interval in seconds."
    },
    "labels": {
      "type": "object",
      "description": "Labels set on the ExternalSecret and on the secret it creates.",
      "additionalProperties": { "type": "string" }
    },
    "annotations": {
      "type": "object",
      "description": "Annotations set on the ExternalSecret and on the secret it creates.",
      "additionalProperties": { "type": "string" }
    },
    "managedSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretName"],
      "properties": {
        "secretName": {
          "type": "string",
          "description": "Name of the ExternalSecret and of the secret it creates."
        },
        "type": {
          "type": "string",
          "description": "Type of the created secret, e.g. kubernetes.io/basic-auth. Defaults to Opaque."
        },
        "template": {
          "type": "object",
          "additionalProperties": false,
          "description": "Omit to sync every secret in scope verbatim.",
          "properties": {
            "includeAllSecrets": {
              "type": "boolean",
              "description": "Retained for compatibility. All secrets in scope are always fetched; data only controls which keys the created secret exposes."
            },
            "data": {
              "type": "object",
              "description": "Keys of the created secret, mapped to go templates over the fetched secrets, e.g. {{ .FOO }}.",
              "additionalProperties": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
