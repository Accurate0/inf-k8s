{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "k8s-storage values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "retainAnnotations": {
      "type": "object",
      "description": "Annotations that keep a volume when it is removed from the app.",
      "additionalProperties": { "type": "string" }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "namespace", "storageClass", "size", "access"],
        "properties": {
          "name": { "type": "string" },
          "namespace": { "type": "string" },
          "storageClass": { "type": "string" },
          "size": { "type": "string" },
          "access": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany", "ReadWriteOncePod"] },
          "labels": { "type": "object", "additionalProperties": { "type": "string" } },
          "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
