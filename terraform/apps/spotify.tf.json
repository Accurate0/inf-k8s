{
  "//": "generated from app.yaml by `ortzi app render`; edit app.yaml instead",
  "resource": {
    "vault_database_secret_backend_static_role": {
      "spotify": {
        "backend": "${var.database_mount}",
        "name": "spotify",
        "db_name": "${var.database_name}",
        "username": "spotify",
        "rotation_period": 315360000
      }
    },
    "vault_policy": {
      "spotify": {
        "name": "db-spotify",
        "policy": "path \"${var.database_mount}/static-creds/spotify\" {\n  capabilities = [\"read\"]\n}\n"
      }
    },
    "vault_kubernetes_auth_backend_role": {
      "spotify": {
        "backend": "${var.kubernetes_auth_path}",
        "role_name": "db-spotify",
        "bound_service_account_names": [
          "openbao-database"
        ],
        "bound_service_account_namespaces": [
          "spotify"
        ],
        "token_policies": [
          "${vault_policy.spotify.name}"
        ],
        "token_ttl": 3600
      }
    },
    "garage_bucket": {
      "spotify-artwork": {
        "global_alias": "spotify-artwork",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "garage_key": {
      "spotify-artwork": {
        "name": "spotify-artwork"
      }
    },
    "garage_bucket_permission": {
      "spotify-artwork": {
        "bucket_id": "${garage_bucket.spotify-artwork.id}",
        "access_key_id": "${garage_key.spotify-artwork.id}",
        "read": true,
        "write": true
      }
    },
    "vault_kv_secret_v2": {
      "spotify-artwork": {
        "mount": "${var.kv_mount}",
        "name": "spotify/resource-artwork",
        "data_json": "{\"S3_BUCKET\":\"spotify-artwork\",\"S3_ENDPOINT\":\"${var.garage_s3_endpoint}\",\"S3_REGION\":\"garage\",\"S3_ACCESS_KEY_ID\":\"${garage_key.spotify-artwork.id}\",\"S3_SECRET_ACCESS_KEY\":\"${garage_key.spotify-artwork.secret_access_key}\"}"
      }
    }
  }
}
