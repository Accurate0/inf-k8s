{
  "//": "generated from app.yaml by `ortzi app render`; edit app.yaml instead",
  "resource": {
    "garage_bucket": {
      "graph-supergraph": {
        "global_alias": "graph-supergraph",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "garage_key": {
      "graph-supergraph": {
        "name": "graph-supergraph"
      }
    },
    "garage_bucket_permission": {
      "graph-supergraph": {
        "bucket_id": "${garage_bucket.graph-supergraph.id}",
        "access_key_id": "${garage_key.graph-supergraph.id}",
        "read": true,
        "write": true
      }
    },
    "vault_kv_secret_v2": {
      "graph-supergraph": {
        "mount": "${var.kv_mount}",
        "name": "graph/resource-supergraph",
        "data_json": "{\"S3_BUCKET\":\"graph-supergraph\",\"S3_ENDPOINT\":\"${var.garage_s3_endpoint}\",\"S3_REGION\":\"garage\",\"S3_ACCESS_KEY_ID\":\"${garage_key.graph-supergraph.id}\",\"S3_SECRET_ACCESS_KEY\":\"${garage_key.graph-supergraph.secret_access_key}\"}"
      }
    }
  }
}
