{
  "//": "generated from app.yaml by `ortzi app render`; edit app.yaml instead",
  "resource": {
    "vault_database_secret_backend_static_role": {
      "bom": {
        "backend": "${var.database_mount}",
        "name": "bom",
        "db_name": "${var.database_name}",
        "username": "bom",
        "rotation_period": 315360000
      }
    },
    "vault_policy": {
      "bom": {
        "name": "db-bom",
        "policy": "path \"${var.database_mount}/static-creds/bom\" {\n  capabilities = [\"read\"]\n}\n"
      }
    },
    "vault_kubernetes_auth_backend_role": {
      "bom": {
        "backend": "${var.kubernetes_auth_path}",
        "role_name": "db-bom",
        "bound_service_account_names": [
          "openbao-database"
        ],
        "bound_service_account_namespaces": [
          "bom"
        ],
        "token_policies": [
          "${vault_policy.bom.name}"
        ],
        "token_ttl": 3600
      }
    },
    "cloudflare_r2_bucket": {
      "bom-images": {
        "account_id": "${var.cloudflare_account_id}",
        "name": "bom-images",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "cloudflare_account_token": {
      "bom-images": {
        "account_id": "${var.cloudflare_account_id}",
        "name": "r2-bom-images",
        "policies": [
          {
            "effect": "allow",
            "permission_groups": [
              {
                "id": "${var.r2_write_permission_group}"
              }
            ],
            "resources": "{\"com.cloudflare.edge.r2.bucket.${var.cloudflare_account_id}_default_${cloudflare_r2_bucket.bom-images.name}\":\"*\"}"
          }
        ]
      }
    },
    "vault_kv_secret_v2": {
      "bom-images": {
        "mount": "${var.kv_mount}",
        "name": "bom/resource-images",
        "data_json": "{\"S3_BUCKET\":\"${cloudflare_r2_bucket.bom-images.name}\",\"S3_ENDPOINT\":\"https://${var.cloudflare_account_id}.r2.cloudflarestorage.com\",\"S3_REGION\":\"auto\",\"S3_ACCESS_KEY_ID\":\"${cloudflare_account_token.bom-images.id}\",\"S3_SECRET_ACCESS_KEY\":\"${sha256(cloudflare_account_token.bom-images.value)}\"}"
      }
    }
  }
}
