{
  "//": "generated from app.yaml by `ortzi app render`; edit app.yaml instead",
  "resource": {
    "vault_database_secret_backend_static_role": {
      "bom": {
        "backend": "${var.database_mount}",
        "name": "bom",
        "db_name": "${var.database_name}",
        "username": "bom",
        "rotation_period": 315360000
      }
    },
    "vault_policy": {
      "bom": {
        "name": "db-bom",
        "policy": "path \"${var.database_mount}/static-creds/bom\" {\n  capabilities = [\"read\"]\n}\n"
      }
    },
    "vault_kubernetes_auth_backend_role": {
      "bom": {
        "backend": "${var.kubernetes_auth_path}",
        "role_name": "db-bom",
        "bound_service_account_names": [
          "openbao-database"
        ],
        "bound_service_account_namespaces": [
          "bom"
        ],
        "token_policies": [
          "${vault_policy.bom.name}"
        ],
        "token_ttl": 3600
      }
    },
    "garage_bucket": {
      "bom-images": {
        "global_alias": "bom-images",
        "lifecycle": {
          "prevent_destroy": true
        }
      }
    },
    "garage_key": {
      "bom-images": {
        "name": "bom-images"
      }
    },
    "garage_bucket_permission": {
      "bom-images": {
        "bucket_id": "${garage_bucket.bom-images.id}",
        "access_key_id": "${garage_key.bom-images.id}",
        "read": true,
        "write": true
      }
    },
    "vault_kv_secret_v2": {
      "bom-images": {
        "mount": "${var.kv_mount}",
        "name": "bom/resource-images",
        "data_json": "{\"S3_BUCKET\":\"bom-images\",\"S3_ENDPOINT\":\"${var.garage_s3_endpoint}\",\"S3_REGION\":\"garage\",\"S3_ACCESS_KEY_ID\":\"${garage_key.bom-images.id}\",\"S3_SECRET_ACCESS_KEY\":\"${garage_key.bom-images.secret_access_key}\"}"
      }
    }
  }
}
