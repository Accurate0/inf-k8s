log:
  level: info

runner:
  file: /data/.runner
  capacity: {{ forgejo_runner_capacity }}
  timeout: 3h
  shutdown_timeout: 3m
  labels:
{% for label, image in forgejo_runner_labels.items() %}
    - {{ label }}:docker://{{ image }}
{% endfor %}

cache:
  enabled: true
  external_server: {{ forgejo_runner_cache_server }}
  secret: {{ forgejo_runner_cache_secret }}
  host: {{ ansible_facts["default_ipv4"]["address"] }}

container:
  # empty gives each job its own network, so services resolve by name (e.g. db)
  network: ""
  docker_host: automount
  force_pull: true
