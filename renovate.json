{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>anurag/k8s//platform-services/renovate/presets/default"],
  "argocd": {
    "managerFilePatterns": [
      "/system-components/.*\\.application\\.yaml$/",
      "/selfhosted/.*\\.application\\.yaml$/",
      "/projects/.*/application\\.yaml$/",
      "/platform-services/.*/application\\.yaml$/"
    ]
  },
  "ignorePaths": [
    "system-components/redis.application.yaml",
    "projects/anurag-sh/application.yaml",
    "projects/bom/application.yaml",
    "projects/home-gateway/application.yaml",
    "projects/maccas-api/application.yaml",
    "projects/ozbargain/application.yaml",
    "projects/tldr-bot/application.yaml",
    "platform-services/ai-gateway/application.yaml",
    "platform-services/feature-flags/application.yaml",
    "platform-services/janitor-bot/application.yaml",
    "platform-services/k8s-schemas/application.yaml",
    "platform-services/kanidm-sync/application.yaml",
    "platform-services/registry/application.yaml",
    "platform-services/waf-manager/application.yaml"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(projects|platform-services)/[^/]+/app\\.yaml$/"],
      "matchStrings": [
        "db:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/system-components/.*\\.application\\.yaml$/",
        "/selfhosted/.*\\.application\\.yaml$/",
        "/projects/.*/application\\.yaml$/",
        "/platform-services/.*/application\\.yaml$/"
      ],
      "matchStrings": [
        "repoURL:\\s*oci://(?<depName>[^\\s]+)\\s*\\n\\s*targetRevision:\\s*(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^platform/versions\\.yaml$/"],
      "matchStrings": ["(?<depName>k8s-[a-z-]+):\\s*(?<currentValue>\\S+)"],
      "packageNameTemplate": "ghcr.io/accurate0/charts/{{{depName}}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/ansible/kubernetes/roles/k3s/vars/main\\.yml$/",
        "/ansible/kubernetes/playbooks/k3s-upgrade\\.yaml$/"
      ],
      "matchStrings": ["k3s_version:\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\+k3s(?<build>\\d+))?$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/platform-services/k8s-schemas/manifests/cronjob\\.yaml$/"
      ],
      "matchStrings": [
        "name: K8S_VERSION\\s*\\n\\s*value:\\s*(?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>v\\d+\\.\\d+\\.\\d+)\\+k3s\\d+$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/system-components/barman-cloud-plugin/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "plugin-barman-cloud/releases/download/(?<currentValue>v[^/]+)/manifest\\.yaml"
      ],
      "depNameTemplate": "cloudnative-pg/plugin-barman-cloud",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/system-components/postgres-cluster/postgres\\.yaml$/"
      ],
      "matchStrings": [
        "imageName:\\s*(?<depName>[^\\s:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(-(?<compatibility>.+))?$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/ansible/local/roles/[^/]+/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*\\w+_(?:version|image_tag):\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
 ,
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packages/upstream/[^/]+/ortzi\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*version:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["argocd"],
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "ghcr.io/accurate0/charts/k8s-http-routes/k8s-http-routes",
        "ghcr.io/accurate0/charts/k8s-secrets/k8s-secrets",
        "ghcr.io/accurate0/charts/k8s-oidc/k8s-oidc",
        "ghcr.io/accurate0/charts/k8s-postgres/k8s-postgres",
        "ghcr.io/external-secrets/charts/external-secrets/external-secrets",
        "ghcr.io/dragonflydb/dragonfly-operator/helm/dragonfly-operator/dragonfly-operator",
        "ghcr.io/bjw-s-labs/helm/app-template/app-template",
        "code.forgejo.org/forgejo-helm/forgejo/forgejo",
        "git.erwanleboucher.dev/eleboucher/charts/forgejo-runner/forgejo-runner"
      ],
      "enabled": false
    },
    {
      "matchFileNames": ["system-components/kanidm/coordinator/Dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/kanidm/server"],
      "enabled": false
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["k3s-io/k3s"],
      "groupName": "k3s",
      "commitMessageTopic": "k3s",
      "automerge": false
    },
    {
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/accurate0/cnpg-postgresql"],
      "labels": ["postgres"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchDatasources": ["helm"],
      "matchPackageNames": ["kube-prometheus-stack"],
      "schedule": ["* * * * 1"]
    },
    {
      "matchFileNames": ["ansible/local/roles/**"],
      "groupName": "ansible local",
      "commitMessageTopic": "ansible local",
      "automerge": false
    },
    {
      "matchFileNames": ["packages/upstream/**"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<revision>\\d+))?$",
      "commitMessageTopic": "upstream {{depName}} cli",
      "minimumReleaseAge": "3 days",
      "postUpgradeTasks": {
        "commands": ["sh scripts/upstream-digests.sh {{{packageFileDir}}}"],
        "fileFilters": ["packages/upstream/**/ortzi.yaml"],
        "executionMode": "update"
      }
    }
  ]
}
