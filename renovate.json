{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>anurag/k8s//platform-services/renovate/presets/default"],
  "flux": {
    "managerFilePatterns": [
      "/^kubernetes/(cert-manager|cnpg-system/cloudnative-pg|cnpg-system/cloudnative-pg-cluster|csi-driver-nfs|default/network-policies|dragonfly-system/dragonfly|envoy-gateway-system/envoy-gateway|external-dns|external-secrets/external-secrets-operator|flux-system/flux-operator|garage|kanidm|longhorn-system/longhorn|monitoring|openbao|reloader)/app/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(projects|platform-services|selfhosted)/[^/]+/app\\.yaml$/"],
      "matchStrings": [
        "chart:\\s*(?<depName>\\S+)\\s*\\n\\s*repo:\\s*(?<registryUrl>https://\\S+)\\s*\\n\\s*version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(projects|platform-services|selfhosted)/[^/]+/app\\.yaml$/"],
      "matchStrings": [
        "repo:\\s*oci://(?<depName>\\S+)\\s*\\n\\s*version:\\s*(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(projects|platform-services)/[^/]+/app\\.yaml$/"],
      "matchStrings": [
        "db:\\s*\\n\\s*image:\\s*(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^(projects|platform-services)/[^/]+/app\\.yaml$/"],
      "matchStrings": ["toolchain:\\s*\\{?\\s*rust:\\s*\"?(?<currentValue>\\d+\\.\\d+\\.\\d+)\"?"],
      "depNameTemplate": "rust-lang/rust",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^selfhosted/[^/]+/image\\.values\\.yaml$/"],
      "matchStrings": [
        "\\n\\s+(?<depName>[^:\\s]+):\\s*(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]+)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^platform/versions\\.yaml$/"],
      "matchStrings": ["(?<depName>k8s-[a-z-]+):\\s*(?<currentValue>\\S+)"],
      "packageNameTemplate": "ghcr.io/accurate0/charts/{{{depName}}}",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^platform/versions\\.yaml$/"],
      "matchStrings": [
        "(?<depName>[\\w.-]+/[\\w.-]+):\\s*(?<currentValue>v[^@\\s]+)@(?<currentDigest>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/ansible/kubernetes/roles/k3s/vars/main\\.yml$/",
        "/ansible/kubernetes/playbooks/k3s-upgrade\\.yaml$/"
      ],
      "matchStrings": ["k3s_version:\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(\\+k3s(?<build>\\d+))?$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/platform-services/k8s-schemas/manifests/cronjob\\.yaml$/"
      ],
      "matchStrings": [
        "name: K8S_VERSION\\s*\\n\\s*value:\\s*(?<currentValue>v\\S+)"
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^(?<version>v\\d+\\.\\d+\\.\\d+)\\+k3s\\d+$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/kubernetes/cnpg-system/cloudnative-pg/config/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "plugin-barman-cloud/releases/download/(?<currentValue>v[^/]+)/manifest\\.yaml"
      ],
      "depNameTemplate": "cloudnative-pg/plugin-barman-cloud",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/kubernetes/cnpg-system/cloudnative-pg-cluster/config/postgres\\.yaml$/"
      ],
      "matchStrings": [
        "imageName:\\s*(?<depName>[^\\s:]+):(?<currentValue>[^\\s]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)(-(?<compatibility>.+))?$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/ansible/local/roles/[^/]+/defaults/main\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*\\w+_(?:version|image_tag):\\s*\"?(?<currentValue>[^\"\\s]+)\"?"
      ]
    }
 ,
    {
      "customType": "regex",
      "managerFilePatterns": ["/^packages/upstream/[^/]+/ortzi\\.yaml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n\\s*version:\\s*(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchFileNames": [".forgejo/workflows/app-*.yaml"],
      "enabled": false
    },
    {
      "matchFileNames": ["platform/versions.yaml"],
      "matchDatasources": ["github-tags"],
      "groupName": "github-actions"
    },
    {
      "matchManagers": ["flux"],
      "matchPackageNames": ["/\\/charts\\/k8s-/"],
      "enabled": false
    },
    {
      "matchFileNames": ["kubernetes/kanidm/config/coordinator/Dockerfile"],
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/kanidm/server"],
      "enabled": false
    },
    {
      "matchDatasources": ["github-releases"],
      "matchPackageNames": ["k3s-io/k3s"],
      "groupName": "k3s",
      "commitMessageTopic": "k3s",
      "automerge": false
    },
    {
      "matchDatasources": ["terraform-provider", "terraform-module"],
      "registryUrls": ["https://registry.opentofu.org"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/accurate0/cnpg-postgresql"],
      "labels": ["postgres"],
      "minimumReleaseAge": "0 days"
    },
    {
      "matchDatasources": ["helm"],
      "matchPackageNames": ["kube-prometheus-stack"],
      "schedule": ["* * * * 1"]
    },
    {
      "matchFileNames": ["ansible/local/roles/**"],
      "groupName": "ansible local",
      "commitMessageTopic": "ansible local",
      "automerge": false
    },
    {
      "matchFileNames": ["packages/upstream/**"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<revision>\\d+))?$",
      "commitMessageTopic": "upstream {{depName}} cli",
      "minimumReleaseAge": "3 days",
      "postUpgradeTasks": {
        "commands": ["sh scripts/upstream-digests.sh {{{packageFileDir}}}"],
        "fileFilters": ["packages/upstream/**/ortzi.yaml"],
        "executionMode": "update"
      }
    }
  ]
}
