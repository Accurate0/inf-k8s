---
extends: default
ignore: |
  target/
  charts/*/templates/
  charts/network-policies/templates/
  kubernetes/cnpg-system/cloudnative-pg/config/manifest.yaml
  platform-services/kanidm-sync/manifests/crd.yaml
  platform-services/waf-manager/manifests/crd.yaml
  platform-services/feature-flags/config/*
  ansible/*/roles/*/templates/
rules:
  line-length: disable
  comments:
    min-spaces-from-content: 1
  truthy:
    check-keys: false
  document-start: disable
