{
  "name": "inf-k8s-packages",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "pnpm --filter @accurate0/feature-flag-client gen",
    "build": "pnpm --filter @accurate0/feature-flag-client build",
    "check": "pnpm -r check",
    "fmt": "eslint --fix . && prettier --write '**/*.{ts,mts,mjs}'",
    "fmt:check": "prettier --check '**/*.{ts,mts,mjs}'",
    "lint": "eslint ."
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "eslint": "10.15.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
