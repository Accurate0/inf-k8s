{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://k8s-schemas.anurag.sh/app.json",
  "title": "app.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "network"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "repository": {
      "type": "string"
    },
    "charts": {
      "type": "object",
      "description": "Pin chart versions for this app.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hosts"
      ],
      "properties": {
        "gateway": {
          "type": "string"
        },
        "unauthenticated": {
          "type": "boolean",
          "description": "Required for a route with no oidc block."
        },
        "workload": {
          "type": "string",
          "description": "Required with several ported workloads."
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        },
        "backend": {
          "type": "object",
          "required": [
            "name",
            "port"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "port": {
              "type": "integer"
            }
          }
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object"
        },
        "ratelimit": {
          "type": "object"
        },
        "timeouts": {
          "type": "object"
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "public": {
          "type": "boolean"
        },
        "displayName": {
          "type": "string"
        },
        "allowLocalhostRedirect": {
          "type": "boolean"
        },
        "host": {
          "type": "string"
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "databaseName": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "name",
              "secretName"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "secretName": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingress"
      ],
      "properties": {
        "ingress": {
          "type": "array",
          "description": "Namespaces allowed to reach this app.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "interval": {
          "type": "string"
        },
        "workload": {
          "type": "string",
          "description": "Required with several ported workloads."
        }
      }
    },
    "workloads": {
      "type": "object",
      "description": "Keyed by workload name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "Deployment",
              "DaemonSet",
              "CronJob"
            ]
          },
          "replicas": {
            "type": "integer"
          },
          "schedule": {
            "type": "string"
          },
          "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              },
              "portName": {
                "type": "string"
              }
            }
          },
          "health": {
            "type": "string",
            "description": "HTTP path for readiness and liveness."
          },
          "resources": {
            "type": "object"
          },
          "env": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "envFrom": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "readOnlyRootFilesystem": {
            "type": "boolean"
          },
          "secrets": {
            "type": "array",
            "description": "Only these app secrets. Defaults to all.",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Extra Argo sources.",
      "items": {
        "type": "object"
      }
    }
  }
}
