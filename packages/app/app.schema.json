{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://k8s-schemas.anurag.sh/app.json",
  "title": "app.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "network"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "repository": {
      "type": "string"
    },
    "charts": {
      "type": "object",
      "description": "Pin chart versions for this app.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingress"
      ],
      "properties": {
        "ingress": {
          "type": "array",
          "description": "Namespaces allowed to reach this app.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "workloads": {
      "type": "object",
      "description": "Keyed by workload name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "Deployment",
              "DaemonSet",
              "CronJob"
            ]
          },
          "replicas": {
            "type": "integer"
          },
          "schedule": {
            "type": "string"
          },
          "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              },
              "portName": {
                "type": "string"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "trafficDistribution": {
                "type": "string"
              }
            }
          },
          "health": {
            "type": "string",
            "description": "HTTP path for readiness and liveness."
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": "string"
              },
              "memory": {
                "type": "string"
              },
              "memoryLimit": {
                "type": "string"
              },
              "requests": {
                "type": "object"
              },
              "limits": {
                "type": "object"
              }
            }
          },
          "env": {
            "description": "Map of variable to a string, {resource}, {secret|database|bucket|oidc, key} or {field}. A list is the raw form.",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "resource"
                      ],
                      "properties": {
                        "resource": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "field"
                      ],
                      "properties": {
                        "field": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "secret",
                        "key"
                      ],
                      "properties": {
                        "secret": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        },
                        "optional": {
                          "type": "boolean"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "database",
                        "key"
                      ],
                      "properties": {
                        "database": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        },
                        "optional": {
                          "type": "boolean"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "bucket",
                        "key"
                      ],
                      "properties": {
                        "bucket": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        },
                        "optional": {
                          "type": "boolean"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "oidc",
                        "key"
                      ],
                      "properties": {
                        "oidc": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        },
                        "optional": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "envFrom": {
            "type": "array",
            "description": "{secret|database|bucket|oidc: resource name}, or a raw secretRef object.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secret": {
                  "type": "string"
                },
                "database": {
                  "type": "string"
                },
                "bucket": {
                  "type": "string"
                },
                "oidc": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                },
                "prefix": {
                  "type": "string"
                },
                "secretRef": {
                  "type": "object"
                },
                "configMapRef": {
                  "type": "object"
                }
              }
            }
          },
          "readOnlyRootFilesystem": {
            "type": "boolean"
          },
          "runAsNonRoot": {
            "type": "boolean"
          },
          "serviceAccountName": {
            "type": "string"
          },
          "probes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "http": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "port"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "port": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                }
              },
              "grpc": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "port"
                ],
                "properties": {
                  "port": {
                    "type": "integer"
                  }
                }
              },
              "startup": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "delay": {
                    "type": "integer"
                  },
                  "every": {
                    "type": "integer"
                  },
                  "timeout": {
                    "type": "integer"
                  },
                  "failures": {
                    "type": "integer"
                  }
                }
              },
              "readiness": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "delay": {
                    "type": "integer"
                  },
                  "every": {
                    "type": "integer"
                  },
                  "timeout": {
                    "type": "integer"
                  },
                  "failures": {
                    "type": "integer"
                  }
                }
              },
              "liveness": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "delay": {
                    "type": "integer"
                  },
                  "every": {
                    "type": "integer"
                  },
                  "timeout": {
                    "type": "integer"
                  },
                  "failures": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "mounts": {
            "type": "object",
            "description": "Keyed by volume name. ConfigMaps mount read-only.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "configMap": {
                  "type": "string"
                },
                "items": {
                  "type": "array",
                  "description": "Paths in the volume; the key is the basename.",
                  "items": {
                    "type": "string"
                  }
                },
                "emptyDir": {
                  "type": "boolean"
                },
                "config": {
                  "type": "string",
                  "description": "A config resource."
                }
              }
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "object"
                }
              ]
            },
            "description": "{name, container, service}. service adds the port to the workload's Service."
          },
          "overrides": {
            "type": "object",
            "description": "Written directly to the k8s-workload values for this workload."
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "backoffLimit": {
            "type": "integer"
          },
          "initContainers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "sidecars": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "serviceAccount": {
            "type": "string",
            "description": "A serviceAccount resource."
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "description": "Named dependencies and what the app exposes.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "app",
              "export"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "app"
                ]
              },
              "app": {
                "type": "string"
              },
              "export": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "Appended to the exported URL."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "provider",
              "secretName"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "bucket"
                ]
              },
              "provider": {
                "enum": [
                  "r2",
                  "s3"
                ]
              },
              "bucket": {
                "type": "string",
                "description": "Defaults to <app>-<name>."
              },
              "user": {
                "type": "string",
                "description": "IAM user name, for s3. Defaults to the bucket name."
              },
              "secretName": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "secretName"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "database"
                ]
              },
              "databaseName": {
                "type": "string"
              },
              "secretName": {
                "type": "string"
              },
              "enableConnectionPooling": {
                "type": "boolean",
                "description": "Connect through the pooler. Defaults to true."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "secretName"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "secret"
                ]
              },
              "secretName": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "instance"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "cache"
                ]
              },
              "instance": {
                "type": "string",
                "description": "A cache export in platform/exports."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "hosts",
              "auth"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "route"
                ]
              },
              "gateway": {
                "type": "string"
              },
              "auth": {
                "type": "object",
                "description": "How this route authenticates. jwt and oidc are enforced at the gateway; app and none need a reason.",
                "additionalProperties": false,
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "jwt",
                      "oidc",
                      "app",
                      "none"
                    ]
                  },
                  "clients": {
                    "type": "array",
                    "description": "oidc clients whose tokens are accepted, for jwt.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "client": {
                    "type": "string",
                    "description": "oidc client with a securityPolicy targeting this route, for oidc."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Why the gateway does not authenticate, for app and none."
                  },
                  "scopes": {
                    "type": "array",
                    "description": "Login scopes, for oidc.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "forwardAccessToken": {
                    "type": "boolean",
                    "description": "For oidc."
                  },
                  "logoutPath": {
                    "type": "string",
                    "description": "For oidc."
                  },
                  "jwt": {
                    "type": "object",
                    "description": "Verify the login token at the gateway, for oidc."
                  }
                }
              },
              "workload": {
                "type": "string",
                "description": "Required with several ported workloads."
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "backend": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "port"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  }
                }
              },
              "paths": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "value"
                      ],
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              },
              "annotations": {
                "type": "object"
              },
              "ratelimit": {
                "type": "object"
              },
              "timeouts": {
                "type": "object"
              },
              "rules": {
                "type": "array",
                "description": "Send paths to different backends. Replaces paths and backend.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "paths",
                    "backend"
                  ],
                  "properties": {
                    "paths": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "value"
                            ],
                            "properties": {
                              "type": {
                                "type": "string"
                              },
                              "value": {
                                "type": "string"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "backend": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "port"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "port": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "oidc"
                ]
              },
              "allowInsecureClientDisablePkce": {
                "type": "boolean"
              },
              "callbackPath": {
                "type": "string"
              },
              "claimMaps": {
                "type": "object"
              },
              "enableLegacyCrypto": {
                "type": "boolean"
              },
              "extraRedirectUrls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "groups": {
                "type": "object"
              },
              "icon": {
                "type": "object"
              },
              "origin": {
                "type": "string"
              },
              "preferShortUsername": {
                "type": "boolean"
              },
              "scopeMapGroup": {
                "type": "string"
              },
              "scopeMaps": {
                "type": "object"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "secretKeys": {
                "type": "object"
              },
              "secretLabels": {
                "type": "object"
              },
              "securityPolicy": {
                "type": "object"
              },
              "public": {
                "type": "boolean"
              },
              "displayName": {
                "type": "string"
              },
              "allowLocalhostRedirect": {
                "type": "boolean"
              },
              "host": {
                "type": "string"
              },
              "secretName": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "type",
              "secretName"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "metrics"
                ]
              },
              "path": {
                "type": "string"
              },
              "interval": {
                "type": "string"
              },
              "workload": {
                "type": "string",
                "description": "Required with several ported workloads."
              },
              "port": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "type"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "export"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "platform"
                ]
              },
              "export": {
                "type": "string",
                "description": "An export in platform/exports."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "configMap",
              "files"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "config"
                ]
              },
              "configMap": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "description": "Relative to the app directory. Mounted at the same relative path; the key is the basename.",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "configMap",
              "file"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "dashboard"
                ]
              },
              "configMap": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "description": "Grafana dashboard json, relative to the app directory."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "serviceAccount"
                ]
              },
              "clusterRole": {
                "type": "string"
              },
              "clusterRules": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          }
        ]
      }
    },
    "exports": {
      "type": "array",
      "description": "Workloads other apps can use as a resource.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "workload"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "workload": {
            "type": "string"
          },
          "port": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Service port name or number. Optional with a single port."
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Extra Argo sources.",
      "items": {
        "type": "object"
      }
    },
    "serviceAccounts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "string"
        },
        "context": {
          "type": "string",
          "description": "Defaults to the app directory."
        },
        "dockerfile": {
          "type": "string",
          "description": "Defaults to <app directory>/Dockerfile."
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "description": "Extra paths that trigger a build.",
          "items": {
            "type": "string"
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "type": "string",
              "description": "Runs in the app directory."
            },
            "db": {
              "type": "string",
              "description": "Postgres image, pinned by digest."
            },
            "dbName": {
              "type": "string"
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "setup": {
              "type": "string"
            }
          }
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
