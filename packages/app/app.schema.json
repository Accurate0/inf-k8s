{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://k8s-schemas.anurag.sh/app.json",
  "title": "app.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "network"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "repository": {
      "type": "string"
    },
    "charts": {
      "type": "object",
      "description": "Pin chart versions for this app.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "name",
              "secretName"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "secretName": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingress"
      ],
      "properties": {
        "ingress": {
          "type": "array",
          "description": "Namespaces allowed to reach this app.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "interval": {
          "type": "string"
        },
        "workload": {
          "type": "string",
          "description": "Required with several ported workloads."
        },
        "port": {
          "type": "string"
        }
      }
    },
    "workloads": {
      "type": "object",
      "description": "Keyed by workload name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "type": "string"
          },
          "port": {
            "type": "integer"
          },
          "kind": {
            "enum": [
              "Deployment",
              "DaemonSet",
              "CronJob"
            ]
          },
          "replicas": {
            "type": "integer"
          },
          "schedule": {
            "type": "string"
          },
          "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              },
              "portName": {
                "type": "string"
              },
              "ports": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "trafficDistribution": {
                "type": "string"
              }
            }
          },
          "health": {
            "type": "string",
            "description": "HTTP path for readiness and liveness."
          },
          "resources": {
            "type": "object"
          },
          "env": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "envFrom": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "readOnlyRootFilesystem": {
            "type": "boolean"
          },
          "secrets": {
            "type": "array",
            "description": "Only these app secrets. Defaults to all.",
            "items": {
              "type": "string"
            }
          },
          "databases": {
            "type": "array",
            "description": "Only these databases. Defaults to all.",
            "items": {
              "type": "string"
            }
          },
          "uses": {
            "type": "array",
            "description": "Resources to inject into this workload's environment.",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "name"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "env": {
                      "type": "string",
                      "description": "Overrides the default variable name."
                    }
                  }
                }
              ]
            }
          },
          "runAsNonRoot": {
            "type": "boolean"
          },
          "serviceAccountName": {
            "type": "string"
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "description": "Named dependencies that workloads select with uses.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "tracing"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "app",
              "export"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "app"
                ]
              },
              "app": {
                "type": "string"
              },
              "export": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "Appended to the exported URL."
              }
            }
          }
        ]
      }
    },
    "exports": {
      "type": "array",
      "description": "Workloads other apps can use as a resource.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "workload"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "workload": {
            "type": "string"
          },
          "port": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Service port name or number. Optional with a single port."
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "Extra Argo sources.",
      "items": {
        "type": "object"
      }
    },
    "databases": {
      "type": "object",
      "description": "Keyed by database name. A workload given several gets prefixed variables.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "databaseName": {
            "type": "string"
          },
          "secretName": {
            "type": "string"
          },
          "enableConnectionPooling": {
            "type": "boolean",
            "description": "Connect through the pooler. Defaults to true."
          }
        }
      }
    },
    "routes": {
      "type": "object",
      "description": "Keyed by route name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hosts",
          "auth"
        ],
        "properties": {
          "gateway": {
            "type": "string"
          },
          "auth": {
            "type": "object",
            "description": "How this route authenticates. jwt and oidc are enforced at the gateway; app and none need a reason.",
            "additionalProperties": false,
            "required": [
              "mode"
            ],
            "properties": {
              "mode": {
                "enum": [
                  "jwt",
                  "oidc",
                  "app",
                  "none"
                ]
              },
              "clients": {
                "type": "array",
                "description": "oidc clients whose tokens are accepted, for jwt.",
                "items": {
                  "type": "string"
                }
              },
              "client": {
                "type": "string",
                "description": "oidc client with a securityPolicy targeting this route, for oidc."
              },
              "reason": {
                "type": "string",
                "description": "Why the gateway does not authenticate, for app and none."
              }
            }
          },
          "workload": {
            "type": "string",
            "description": "Required with several ported workloads."
          },
          "hosts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "backend": {
            "type": "object",
            "required": [
              "name",
              "port"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "port": {
                "type": "integer"
              }
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "value"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "annotations": {
            "type": "object"
          },
          "ratelimit": {
            "type": "object"
          },
          "timeouts": {
            "type": "object"
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "description": "Keyed by client name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "public": {
            "type": "boolean"
          },
          "displayName": {
            "type": "string"
          },
          "allowLocalhostRedirect": {
            "type": "boolean"
          },
          "host": {
            "type": "string"
          }
        }
      }
    },
    "serviceAccounts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "string"
        },
        "context": {
          "type": "string",
          "description": "Defaults to the app directory."
        },
        "dockerfile": {
          "type": "string",
          "description": "Defaults to <app directory>/Dockerfile."
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "description": "Extra paths that trigger a build.",
          "items": {
            "type": "string"
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "type": "string",
              "description": "Runs in the app directory."
            },
            "db": {
              "type": "string",
              "description": "Postgres image, pinned by digest."
            },
            "dbName": {
              "type": "string"
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "setup": {
              "type": "string"
            }
          }
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
