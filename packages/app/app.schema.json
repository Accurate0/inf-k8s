{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://k8s-schemas.anurag.sh/app.json",
  "title": "app.yaml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "network"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
    },
    "repository": {
      "type": "string"
    },
    "charts": {
      "type": "object",
      "description": "Pin chart versions for this app.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingress"
      ],
      "properties": {
        "ingress": {
          "type": "array",
          "description": "Namespaces allowed to reach this app.",
          "items": {
            "type": "string"
          }
        },
        "policy": {
          "type": "boolean",
          "description": "Render the namespace's default-deny network policies. Defaults to true; must be set explicitly with namespace.name."
        }
      }
    },
    "workloads": {
      "type": "array",
      "description": "What the app runs.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "image"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "Deployment",
              "DaemonSet",
              "CronJob"
            ]
          },
          "replicas": {
            "type": "integer"
          },
          "schedule": {
            "type": "string"
          },
          "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "trafficDistribution": {
                "type": "string"
              }
            },
            "required": [
              "name"
            ]
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "cpu": {
                "type": "string"
              },
              "memory": {
                "type": "string"
              },
              "memoryLimit": {
                "type": "string"
              }
            }
          },
          "env": {
            "description": "Map of variable to a string, {resource}, {service, port}, {secret|database|bucket|oidc, key} or {field}. A list is the raw form.",
            "oneOf": [
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              {
                "type": "object",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "resource"
                      ],
                      "properties": {
                        "resource": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "service",
                        "port"
                      ],
                      "properties": {
                        "service": {
                          "type": "string",
                          "description": "A service of this app."
                        },
                        "port": {
                          "type": [
                            "string",
                            "integer"
                          ]
                        },
                        "path": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "field"
                      ],
                      "properties": {
                        "field": {
                          "type": "string"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "secret",
                        "key"
                      ],
                      "properties": {
                        "secret": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        },
                        "optional": {
                          "type": "boolean"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "database",
                        "key"
                      ],
                      "properties": {
                        "database": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        },
                        "optional": {
                          "type": "boolean"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "bucket",
                        "key"
                      ],
                      "properties": {
                        "bucket": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        },
                        "optional": {
                          "type": "boolean"
                        }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "oidc",
                        "key"
                      ],
                      "properties": {
                        "oidc": {
                          "type": "string"
                        },
                        "key": {
                          "type": "string"
                        },
                        "optional": {
                          "type": "boolean"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          },
          "envFrom": {
            "type": "array",
            "description": "{secret|database|bucket|oidc: resource name}, or a raw secretRef object.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secret": {
                  "type": "string"
                },
                "database": {
                  "type": "string"
                },
                "bucket": {
                  "type": "string"
                },
                "oidc": {
                  "type": "string"
                },
                "optional": {
                  "type": "boolean"
                },
                "prefix": {
                  "type": "string"
                },
                "secretRef": {
                  "type": "object"
                },
                "configMapRef": {
                  "type": "object"
                }
              }
            }
          },
          "readOnlyRootFilesystem": {
            "type": "boolean"
          },
          "runAsNonRoot": {
            "type": "boolean"
          },
          "probes": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "http": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "port"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "port": {
                    "type": [
                      "integer",
                      "string"
                    ]
                  }
                }
              },
              "grpc": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "port"
                ],
                "properties": {
                  "port": {
                    "type": "integer"
                  }
                }
              },
              "startup": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "delay": {
                    "type": "integer"
                  },
                  "every": {
                    "type": "integer"
                  },
                  "timeout": {
                    "type": "integer"
                  },
                  "failures": {
                    "type": "integer"
                  }
                }
              },
              "readiness": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "delay": {
                    "type": "integer"
                  },
                  "every": {
                    "type": "integer"
                  },
                  "timeout": {
                    "type": "integer"
                  },
                  "failures": {
                    "type": "integer"
                  }
                }
              },
              "liveness": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "delay": {
                    "type": "integer"
                  },
                  "every": {
                    "type": "integer"
                  },
                  "timeout": {
                    "type": "integer"
                  },
                  "failures": {
                    "type": "integer"
                  }
                }
              }
            }
          },
          "mounts": {
            "type": "object",
            "description": "Keyed by volume name. ConfigMaps mount read-only.",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "configMap": {
                  "type": "string"
                },
                "emptyDir": {
                  "type": "boolean"
                },
                "config": {
                  "type": "string",
                  "description": "A config resource."
                },
                "volume": {
                  "type": "string",
                  "description": "A volume resource."
                }
              }
            }
          },
          "ports": {
            "type": "array",
            "description": "{name, container, service}. service adds the port to the workload's Service.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "container"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "container": {
                  "type": "integer"
                },
                "service": {
                  "type": "integer"
                },
                "appProtocol": {
                  "type": "string"
                }
              }
            }
          },
          "overrides": {
            "type": "object",
            "description": "Written directly to the k8s-workload values for this workload."
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "backoffLimit": {
            "type": "integer"
          },
          "initContainers": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "sidecars": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ports": {
                  "type": "array",
                  "description": "{name, container, service}. service adds the port to the workload's Service.",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "name",
                      "container"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "container": {
                        "type": "integer"
                      },
                      "service": {
                        "type": "integer"
                      },
                      "appProtocol": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "serviceAccount": {
            "type": "string",
            "description": "A serviceAccount resource."
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "description": "Named dependencies and what the app exposes.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "app",
              "export"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "app"
                ]
              },
              "app": {
                "type": "string"
              },
              "export": {
                "type": "string"
              },
              "path": {
                "type": "string",
                "description": "Appended to the exported URL."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "provider",
              "secretName",
              "bucket"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "bucket"
                ]
              },
              "provider": {
                "enum": [
                  "r2",
                  "s3"
                ]
              },
              "bucket": {
                "type": "string"
              },
              "user": {
                "type": "string",
                "description": "IAM user name, for s3. Defaults to the bucket name."
              },
              "secretName": {
                "type": "string"
              },
              "secretTemplate": {
                "type": "object",
                "description": "Reshape the synced secret, for consumers that expect other keys.",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "secretName"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "database"
                ]
              },
              "secretName": {
                "type": "string"
              },
              "enableConnectionPooling": {
                "type": "boolean",
                "description": "Connect through the pooler. Defaults to true."
              },
              "role": {
                "type": "string",
                "description": "Postgres role and database name. Defaults to the name with hyphens as underscores."
              },
              "extensions": {
                "type": "array",
                "description": "Postgres extensions to ensure are present.",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "secretName"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "secret"
                ]
              },
              "secretName": {
                "type": "string"
              },
              "secretTemplate": {
                "type": "object",
                "description": "Reshape the synced secret, for consumers that expect other keys.",
                "additionalProperties": false,
                "required": [
                  "data"
                ],
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "includeAllSecrets": {
                    "type": "boolean"
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "instance"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "cache"
                ]
              },
              "instance": {
                "type": "string",
                "description": "A cache export in platform/exports."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "hosts",
              "auth"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "route"
                ]
              },
              "gateway": {
                "type": "string"
              },
              "auth": {
                "type": "object",
                "description": "How this route authenticates. jwt and oidc are enforced at the gateway; app and none need a reason.",
                "additionalProperties": false,
                "required": [
                  "mode"
                ],
                "properties": {
                  "mode": {
                    "enum": [
                      "jwt",
                      "oidc",
                      "app",
                      "none"
                    ]
                  },
                  "clients": {
                    "type": "array",
                    "description": "oidc clients whose tokens are accepted, for jwt.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "client": {
                    "type": "string",
                    "description": "oidc client with a securityPolicy targeting this route, for oidc."
                  },
                  "reason": {
                    "type": "string",
                    "description": "Why the gateway does not authenticate, for app and none."
                  },
                  "scopes": {
                    "type": "array",
                    "description": "Login scopes, for oidc.",
                    "items": {
                      "type": "string"
                    }
                  },
                  "forwardAccessToken": {
                    "type": "boolean",
                    "description": "For oidc."
                  },
                  "logoutPath": {
                    "type": "string",
                    "description": "For oidc."
                  },
                  "jwt": {
                    "type": "object",
                    "description": "Verify the login token at the gateway, for oidc."
                  }
                }
              },
              "hosts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "backend": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "port"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "port": {
                    "type": "integer"
                  }
                }
              },
              "paths": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "required": [
                        "type",
                        "value"
                      ],
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "value": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              },
              "ratelimit": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "requests",
                  "per",
                  "header"
                ],
                "properties": {
                  "requests": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "per": {
                    "enum": [
                      "Second",
                      "Minute",
                      "Hour",
                      "Day"
                    ]
                  },
                  "header": {
                    "type": "string",
                    "description": "Limit each distinct value of this request header."
                  }
                }
              },
              "timeouts": {
                "type": "object"
              },
              "rules": {
                "type": "array",
                "description": "Send paths to different backends. Replaces paths and backend.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "paths",
                    "backend"
                  ],
                  "properties": {
                    "paths": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "object",
                            "required": [
                              "type",
                              "value"
                            ],
                            "properties": {
                              "type": {
                                "type": "string"
                              },
                              "value": {
                                "type": "string"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "backend": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name",
                        "port"
                      ],
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "port": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              },
              "dns": {
                "description": "Publish the route's hosts in DNS.",
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "provider",
                      "proxied"
                    ],
                    "properties": {
                      "provider": {
                        "enum": [
                          "cloudflare"
                        ]
                      },
                      "proxied": {
                        "type": "boolean"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "provider"
                    ],
                    "properties": {
                      "provider": {
                        "enum": [
                          "unifi"
                        ]
                      }
                    }
                  }
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "oidc"
                ]
              },
              "allowInsecureClientDisablePkce": {
                "type": "boolean"
              },
              "callbackPath": {
                "type": "string"
              },
              "claimMaps": {
                "type": "object"
              },
              "enableLegacyCrypto": {
                "type": "boolean"
              },
              "extraRedirectUrls": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "groups": {
                "type": "object"
              },
              "icon": {
                "type": "object"
              },
              "origin": {
                "type": "string"
              },
              "preferShortUsername": {
                "type": "boolean"
              },
              "scopeMapGroup": {
                "type": "string"
              },
              "scopeMaps": {
                "type": "object"
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "secretKeys": {
                "type": "object"
              },
              "secretLabels": {
                "type": "object"
              },
              "public": {
                "type": "boolean"
              },
              "displayName": {
                "type": "string"
              },
              "allowLocalhostRedirect": {
                "type": "boolean"
              },
              "host": {
                "type": "string"
              },
              "secretName": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "type",
              "secretName",
              "host"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "metrics"
                ]
              },
              "path": {
                "type": "string"
              },
              "interval": {
                "type": "string"
              },
              "workload": {
                "type": "string"
              },
              "port": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "type",
              "workload",
              "port"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "export"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "platform"
                ]
              },
              "export": {
                "type": "string",
                "description": "An export in platform/exports."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "configMap",
              "files"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "config"
                ]
              },
              "configMap": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "description": "Relative to the app directory. Mounted at the same relative path; the key is the basename.",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "configMap",
              "file"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "dashboard"
                ]
              },
              "configMap": {
                "type": "string"
              },
              "file": {
                "type": "string",
                "description": "Grafana dashboard json, relative to the app directory."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "serviceAccount"
                ]
              },
              "clusterRole": {
                "type": "string"
              },
              "clusterRules": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "type",
              "claimName",
              "class",
              "size",
              "access"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "volume"
                ]
              },
              "claimName": {
                "type": "string",
                "description": "Name of the persistent volume claim."
              },
              "class": {
                "type": "string",
                "description": "A storage export from platform/exports."
              },
              "size": {
                "type": "string"
              },
              "access": {
                "enum": [
                  "ReadWriteOnce",
                  "ReadWriteMany",
                  "ReadOnlyMany",
                  "ReadWriteOncePod"
                ]
              },
              "backup": {
                "enum": [
                  "daily"
                ]
              }
            }
          }
        ]
      }
    },
    "exports": {
      "type": "array",
      "description": "Workloads other apps can use as a resource.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "workload",
          "port"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "workload": {
            "type": "string"
          },
          "port": {
            "type": [
              "string",
              "integer"
            ],
            "description": "Service port name or number."
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "description": "What the app deploys beyond its workloads and resources.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "chart",
              "repo",
              "version",
              "values"
            ],
            "properties": {
              "type": {
                "enum": [
                  "helm"
                ]
              },
              "chart": {
                "type": "string"
              },
              "repo": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "values": {
                "type": "string",
                "description": "Values file, relative to the app directory."
              },
              "releaseName": {
                "type": "string",
                "description": "Defaults to the app name. Required when a chart is listed twice."
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "repo",
              "path"
            ],
            "properties": {
              "type": {
                "enum": [
                  "git"
                ]
              },
              "repo": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "revision": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "path"
            ],
            "properties": {
              "type": {
                "enum": [
                  "manifests"
                ]
              },
              "path": {
                "type": "string",
                "description": "Kustomization directory, relative to the app directory. Use . for the app directory."
              }
            }
          }
        ]
      }
    },
    "overrides": {
      "description": "Change what one output generates. Keyed by output, then generated object. Every block is validated, even for outputs that are not active.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "argocd": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "application": {
              "description": "Change the rendered Argo Application.",
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "options": {
                  "type": "array",
                  "description": "Replaces the default syncOptions.",
                  "items": {
                    "type": "string"
                  }
                },
                "automated": {
                  "type": "boolean",
                  "description": "Sync automatically with prune and self-heal. Defaults to true."
                },
                "ignoreDifferences": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "string"
        },
        "context": {
          "type": "string",
          "description": "Defaults to the app directory."
        },
        "dockerfile": {
          "type": "string",
          "description": "Defaults to <app directory>/Dockerfile."
        },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "paths": {
          "type": "array",
          "description": "Extra paths that trigger a build.",
          "items": {
            "type": "string"
          }
        },
        "test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run"
          ],
          "properties": {
            "run": {
              "type": "string",
              "description": "Runs in the app directory."
            },
            "db": {
              "type": "string",
              "description": "Postgres image, pinned by digest."
            },
            "dbName": {
              "type": "string"
            },
            "packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "setup": {
              "type": "string"
            }
          }
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Deploy into this existing namespace instead of one named after the app."
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Applied through k8s-workload, or managedNamespaceMetadata for an app with no workloads."
        }
      }
    }
  }
}
