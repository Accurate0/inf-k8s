package ortzi:host@0.1.0;

interface process {
  enum stdio {
    inherit,
    piped,
    null,
  }

  record command {
    program: string,
    args: list<string>,
    env: list<tuple<string, string>>,
    cwd: option<string>,
    stdin: option<list<u8>>,
    stdout: stdio,
    stderr: stdio,
  }

  record output {
    code: option<s32>,
    stdout: list<u8>,
    stderr: list<u8>,
  }

  run: func(command: command) -> result<output, string>;
}

interface fs {
  record entry {
    name: string,
    dir: bool,
  }

  read-file: func(path: string) -> result<list<u8>, string>;
  write-file: func(path: string, contents: list<u8>) -> result<_, string>;
  read-dir: func(path: string) -> result<list<entry>, string>;
  exists: func(path: string) -> result<bool, string>;
  create-dir-all: func(path: string) -> result<_, string>;
  remove: func(path: string) -> result<_, string>;
}

interface kube {
  record request {
    context: option<string>,
    method: string,
    path: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
  }

  record response {
    status: u16,
    body: list<u8>,
  }

  send: func(request: request) -> result<response, string>;
}

interface http {
  record request {
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
    timeout-ms: option<u32>,
  }

  record response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  send: func(request: request) -> result<response, string>;
}

interface serve {
  record request {
    method: string,
    path: string,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  record response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  /// Binds 127.0.0.1 on a port from the package's permissions.listen.
  listen: func(port: u16) -> result<_, string>;
  /// Blocks until the next request; answer it with respond before accepting another.
  accept: func() -> result<request, string>;
  respond: func(response: response) -> result<_, string>;

  /// Reverse-proxies HTTP, server-sent events and websockets from 127.0.0.1 on a port from
  /// permissions.listen to upstream, an https URL from permissions.http, until ctrl-c. Each request
  /// and websocket connection_init carries the package's freshly refreshed token, and only
  /// localhost hosts and origins are answered. When page is set, a browser loading / gets that HTML
  /// instead of the upstream.
  proxy: func(port: u16, upstream: string, page: option<string>) -> result<_, string>;
}

interface auth {
  /// The package's access token, refreshed when it is about to expire.
  token: func() -> result<string, string>;
}

interface registry {
  record push {
    dir: string,
    reference: string,
    tags: list<string>,
    revision: option<string>,
    sign: bool,
  }

  record pushed {
    digest: string,
    changed: bool,
  }

  /// Pushes dir as a single-layer OCI artifact to reference (oci://host/project/name), whose
  /// project must be in permissions.registry. Nothing is uploaded or signed when every tag already
  /// holds the same content.
  push-dir: func(request: push) -> result<pushed, string>;
}

interface env {
  args: func() -> list<string>;
  vars: func() -> list<tuple<string, string>>;
  cwd: func() -> string;
  stdin-is-terminal: func() -> bool;
  exit: func(code: u8);
}

world cli {
  import process;
  import fs;
  import env;
  import kube;
  import http;
  import serve;
  import auth;
  import registry;
  export wasi:cli/run@0.2.12;
}

world guest {
  include cli;
  import wasi:cli/stdin@0.2.12;
  import wasi:cli/stdout@0.2.12;
  import wasi:cli/stderr@0.2.12;
}
